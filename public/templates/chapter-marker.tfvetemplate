  "publishedParams": [
    {
      "id": "param_title_text",
      "name": "Title Text",
      "type": "text",
      "targetClipId": "tpl_clip_1",
      "targetProperty": "text.content",
      "defaultValue": "CHAPTER 01\nTHE BEGINNING"
    },
    {
      "id": "param_font_family",
      "name": "Font Family",
      "type": "font",
      "targetClipId": "tpl_clip_1",
