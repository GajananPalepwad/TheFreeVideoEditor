      "targetClipId": "tpl_clip_1",
      "targetProperty": "text.fontSize",
      "defaultValue": 58,
      "min": 29,
      "max": 87,
      "step": 1
    },
    {
      "id": "param_text_color",
      "name": "Text Color",
      "type": "color",
      "targetClipId": "tpl_clip_1",
