{
	"name": "thefreevideoeditor",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"lint": "eslint \"src/**/*.{ts,tsx}\"",
		"preview": "astro preview",
		"astro": "astro",
		"deploy": "npm run build && wrangler deploy",
		"typecheck": "astro check && tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:gpu": "node scripts/test-gpu.mjs",
		"test:captions:real": "playwright test tests/e2e/captions-real.spec.ts",
		"format:check": "prettier --check src/editor src/pages/editor.astro src/layouts/Layout.astro src/styles astro.config.mjs eslint.config.mjs",
		"templates:generate": "node scripts/generate-templates.mjs"
	},
	"dependencies": {
		"@astrojs/react": "^7.0.0",
		"@ffmpeg-installer/ffmpeg": "^1.1.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@huggingface/transformers": "^4.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "^7.3.5",
		"fflate": "^0.8.3",
		"idb": "^8.0.3",
		"immer": "^11.1.21",
		"mediabunny": "^1.61.3",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"youtube-dl-exec": "^3.1.17",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@playwright/test": "^1.63.0",
		"@vitest/coverage-v8": "5.0.3",
		"eslint": "^10.12.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"fake-indexeddb": "^6.2.5",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	}
}
