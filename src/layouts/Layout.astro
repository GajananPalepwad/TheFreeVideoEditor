---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: string;
	ogType?: string;
	ogImage?: string;
	keywords?: string;
	robots?: string;
	articleSection?: string;
	articleTags?: string[];
	publishedTime?: string;
	modifiedTime?: string;
}

const {
	title = 'The Free Video Editor — Free Online Video Editor & AI Video Editor in Your Browser',
	description = 'The Free Video Editor is a fast, free online video editor and AI video editor in your browser. Trim silences with Smart Cut, generate on-device AI captions, edit 4K multi-track video, and export without watermarks or cloud uploads.',
	canonicalUrl = 'https://thefreevideoeditor.com/',
	ogType = 'website',
	ogImage = 'https://thefreevideoeditor.com/og-image.png',
	keywords = 'video editor, free video editor, online video editor, ai video editor, smart cut silence remover, remove silence from video free, ai silence trimmer, auto cut pauses, speech to text subtitles, ai subtitles generator, free ai video editor, video editor online, video editor free, youtube video editor, capcut video editor, canva video editor, movavi video editor, adobe video editor, windows video editor, openshot video editor, free online video editor, best free video editor, ai video editor free, microsoft video editor, best video editor, video editor jobs',
	robots = 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
	articleSection,
	articleTags,
	publishedTime,
	modifiedTime
} = Astro.props;

function normalizeCanonical(rawUrl: string): string {
	try {
		const parsed = new URL(rawUrl);
		parsed.protocol = 'https:';
		if (parsed.hostname.startsWith('www.')) {
			parsed.hostname = parsed.hostname.replace(/^www\./, '');
		}
		const hasExt = /\.[a-zA-Z0-9]+$/.test(parsed.pathname);
		if (!hasExt && !parsed.pathname.endsWith('/')) {
			parsed.pathname = `${parsed.pathname}/`;
		}
		return `${parsed.protocol}//${parsed.hostname}${parsed.pathname}`;
	} catch {
		return rawUrl;
	}
}

const currentCanonical = normalizeCanonical(canonicalUrl || 'https://thefreevideoeditor.com/');
---

<!doctype html>
<html lang="en">
	<head>
		{import.meta.env.PROD && (
			<>
				{/* Google tag (gtag.js) */}
				<script async src="https://www.googletagmanager.com/gtag/js?id=G-S0B2C9G9X7" />
				<script is:inline>
					window.dataLayer = window.dataLayer || [];
					function gtag() {
						dataLayer.push(arguments);
					}
					gtag('js', new Date());

					gtag('config', 'G-S0B2C9G9X7');
				</script>
			</>
		)}
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="application-name" content="The Free Video Editor" />
		<meta name="apple-mobile-web-app-title" content="The Free Video Editor" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#090909" />
		<link rel="canonical" href={currentCanonical} />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Anton&family=Bebas+Neue&family=Bodoni+Moda&family=Caveat:wght@400;700&family=Cinzel:wght@400;700&family=Dancing+Script:wght@400;700&family=Fira+Code&family=Great+Vibes&family=Inter:wght@400;600;800&family=JetBrains+Mono&family=Lato:wght@400;700&family=Lobster&family=Lora&family=Merriweather&family=Montserrat:wght@400;700;900&family=Nunito&family=Open+Sans&family=Oswald:wght@500;700&family=Pacifico&family=Playfair+Display:wght@400;700&family=Poppins:wght@400;600;800&family=Raleway&family=Roboto+Mono&family=Roboto:wght@400;700&family=Rubik&family=Sacramento&family=Satisfy&family=Space+Mono&family=Ubuntu&family=Work+Sans&display=swap"
			rel="stylesheet"
		/>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={currentCanonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta
			property="og:image:alt"
			content="The Free Video Editor — Free Online AI Video Editor in Your Browser"
		/>
		<meta property="og:site_name" content="The Free Video Editor" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={currentCanonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta
			name="twitter:image:alt"
			content="The Free Video Editor — Free Online AI Video Editor in Your Browser"
		/>

		<!-- Structured Data (JSON-LD) for SoftwareApplication & WebSite -->
		<script
			type="application/ld+json"
			set:html={JSON.stringify([
				{
					'@context': 'https://schema.org',
					'@type': 'WebSite',
					name: 'The Free Video Editor',
					alternateName: ['Free Video Editor', 'Online Video Editor', 'TFVE'],
					url: 'https://thefreevideoeditor.com/',
					description: description,
					potentialAction: {
						'@type': 'SearchAction',
						target: 'https://thefreevideoeditor.com/editor/?q={search_term_string}',
						'query-input': 'required name=search_term_string'
					}
				},
				{
					'@context': 'https://schema.org',
					'@type': 'WebApplication',
					name: 'The Free Video Editor',
					url: 'https://thefreevideoeditor.com/',
					applicationCategory: 'MultimediaApplication',
					operatingSystem: 'All modern web browsers (Chrome, Edge, Firefox, Safari)',
					offers: {
						'@type': 'Offer',
						price: '0',
						priceCurrency: 'USD'
					},
					description:
						'A free online video editor and AI video editor running locally in the browser with WebCodecs, WebGL2, multi-track timeline, Smart Cut AI silence removal, automatic Whisper captions, and zero cloud uploads.',
					featureList: [
						'Smart Cut: on-device AI silence and pause removal with voice activity detection (VAD)',
						'On-device Whisper AI speech-to-text captions and subtitles with word-level sync',
						'Hardware-accelerated 4K 60fps WebCodecs multi-track video timeline',
						'Dedicated AI workspace, Assembly, Editing, Color, Effects, Audio, and Graphics layouts',
						'Professional 3-way color grading wheels, Lumetri-style tone curves, and 3D LUTs',
						'Multi-track audio mixer with parametric EQ, compressor, and loudness metering',
						'Subpixel 2D motion tracking and keyframe animation with Bezier easing curves',
						'Zero cloud uploads, 100% private client-side processing, and no export watermarks'
					]
				}
			])}
		/>
		<!-- Article Open Graph metadata (when ogType === 'article') -->
		{ogType === 'article' && articleSection && (
			<meta property="article:section" content={articleSection} />
		)}
		{ogType === 'article' &&
			articleTags?.map((tag) => <meta property="article:tag" content={tag} />)}
		{ogType === 'article' && publishedTime && (
			<meta property="article:published_time" content={publishedTime} />
		)}
		{ogType === 'article' && modifiedTime && (
			<meta property="article:modified_time" content={modifiedTime} />
		)}

		<!-- Page-Specific Injected Head Content (e.g. JSON-LD Structured Data) -->
		<slot name="head" />
	</head>
	<body>
		<slot />
		<script>
			import { initActivityTracking } from '../services/activityTracking';
			initActivityTracking();
		</script>
	</body>
</html>
