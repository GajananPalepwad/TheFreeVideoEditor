---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { TOOL_GUIDES, getRelatedGuides, type ToolGuide } from '../../data/guides';

export async function getStaticPaths() {
	return TOOL_GUIDES.map((guide, idx) => {
		const prevGuide = idx > 0 ? TOOL_GUIDES[idx - 1] : TOOL_GUIDES[TOOL_GUIDES.length - 1];
		const nextGuide = idx < TOOL_GUIDES.length - 1 ? TOOL_GUIDES[idx + 1] : TOOL_GUIDES[0];
		return {
			params: { slug: guide.id },
			props: { guide, prevGuide, nextGuide }
		};
	});
}

interface Props {
	guide: ToolGuide;
	prevGuide: ToolGuide;
	nextGuide: ToolGuide;
}

const { guide, prevGuide, nextGuide } = Astro.props;
const relatedGuides = getRelatedGuides(guide);

const seoTitle = `${guide.title} Tutorial & Complete Workflow Guide — The Free Video Editor`;
const seoDescription = `${guide.subtitle} Follow step-by-step instructions, keyboard shortcuts, pro tips, and video walkthroughs for ${guide.title} in The Free Video Editor.`;
const canonical = `https://thefreevideoeditor.com/guides/${guide.id}/`;

const toolKeywords = [
	guide.title,
	`${guide.title.toLowerCase()} guide`,
	`${guide.title.toLowerCase()} tutorial`,
	`how to use ${guide.title.toLowerCase()}`,
	guide.shortcut ? `${guide.title.toLowerCase()} shortcut ${guide.shortcut}` : '',
	guide.categoryLabel,
	'video editing guide',
	'free video editor tutorial',
	'the free video editor',
	...guide.whenToUse.slice(0, 3).map((w) => w.toLowerCase())
]
	.filter(Boolean)
	.join(', ');

const guideJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'TechArticle',
		headline: `${guide.title} Tutorial & Step-by-Step Workflow Guide`,
		alternativeHeadline: guide.subtitle,
		description: seoDescription,
		url: canonical,
		inLanguage: 'en-US',
		proficiencyLevel: guide.difficulty,
		articleSection: guide.categoryLabel,
		timeRequired: `PT${guide.readingTimeMinutes}M`,
		author: {
			'@type': 'Organization',
			name: 'The Free Video Editor Editorial Team',
			url: 'https://thefreevideoeditor.com'
		},
		publisher: {
			'@type': 'Organization',
			name: 'The Free Video Editor',
			url: 'https://thefreevideoeditor.com',
			logo: {
				'@type': 'ImageObject',
				url: 'https://thefreevideoeditor.com/favicon.svg'
			}
		},
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': canonical
		},
		datePublished: '2026-01-01T00:00:00Z',
		dateModified: new Date().toISOString()
	},
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: `How to Use ${guide.title} in The Free Video Editor`,
		description: guide.subtitle,
		totalTime: `PT${guide.readingTimeMinutes}M`,
		tool: [
			{
				'@type': 'HowToTool',
				name: 'The Free Video Editor'
			}
		],
		step: guide.steps.map((step) => ({
			'@type': 'HowToStep',
			position: step.stepNumber,
			name: step.title,
			text: step.description,
			url: `${canonical}#step-${step.stepNumber}`
		}))
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: 'https://thefreevideoeditor.com/'
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Guides',
				item: 'https://thefreevideoeditor.com/guides/'
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: guide.title,
				item: canonical
			}
		]
	}
];

if (guide.faq && guide.faq.length > 0) {
	guideJsonLd.push({
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: guide.faq.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer
			}
		}))
	});
}

if (guide.youtubeVideoId) {
	guideJsonLd.push({
		'@context': 'https://schema.org',
		'@type': 'VideoObject',
		name: `${guide.title} Video Tutorial — The Free Video Editor`,
		description: guide.subtitle,
		thumbnailUrl: [
			`https://img.youtube.com/vi/${guide.youtubeVideoId}/maxresdefault.jpg`,
			`https://img.youtube.com/vi/${guide.youtubeVideoId}/hqdefault.jpg`
		],
		uploadDate: '2026-01-01T00:00:00Z',
		contentUrl: `https://www.youtube.com/watch?v=${guide.youtubeVideoId}`,
		embedUrl: `https://www.youtube-nocookie.com/embed/${guide.youtubeVideoId}`
	});
}
---

<Layout
	title={seoTitle}
	description={seoDescription}
	canonicalUrl={canonical}
	keywords={toolKeywords}
	ogType="article"
	articleSection={guide.categoryLabel}
	articleTags={[guide.title, guide.categoryLabel, 'Video Editing', 'Tutorial', 'The Free Video Editor']}
	publishedTime="2026-01-01T00:00:00Z"
	modifiedTime={new Date().toISOString()}
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(guideJsonLd)} />
	</Fragment>
	<Header />

	<main class="guide-detail-main">
		<!-- Breadcrumbs -->
		<nav class="guide-breadcrumb-nav" aria-label="Breadcrumb">
			<div class="guide-container">
				<ol class="breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
					<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
						<a href="/" class="breadcrumb-link" itemprop="item"><span itemprop="name">Home</span></a>
						<meta itemprop="position" content="1" />
					</li>
					<li class="breadcrumb-sep" aria-hidden="true">/</li>
					<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
						<a href="/guides/" class="breadcrumb-link" itemprop="item"><span itemprop="name">Guides</span></a>
						<meta itemprop="position" content="2" />
					</li>
					<li class="breadcrumb-sep" aria-hidden="true">/</li>
					<li aria-current="page" class="breadcrumb-current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
						<span itemprop="name">{guide.title}</span>
						<meta itemprop="position" content="3" />
					</li>
				</ol>
			</div>
		</nav>

		<!-- Tool Hero Section -->
		<header class="guide-hero">
			<div class="hero-ambient-glow" aria-hidden="true"></div>
			<div class="guide-container">
				<div class="hero-header-row">
					<div class="tool-hero-icon-box">
						<ToolIcon name={guide.icon} size={36} />
					</div>
					<div class="hero-badge-group">
						<span class="category-pill">{guide.categoryLabel}</span>
						{guide.shortcut && (
							<span class="shortcut-pill">
								Shortcut: <kbd>{guide.shortcut}</kbd>
							</span>
						)}
						<span class="difficulty-pill">{guide.difficulty}</span>
						<span class="reading-time-pill">{guide.readingTimeMinutes} min read</span>
					</div>
				</div>

				<h1 class="guide-title">{guide.title}</h1>
				<p class="guide-lead">{guide.subtitle}</p>

				<!-- Hero Meta & Quick Actions -->
				<div class="hero-actions-bar">
					<div class="action-buttons-group">
						<a href="/editor/" class="hero-cta-btn">
							<span>Try in Editor</span>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<polyline points="9 18 15 12 9 6"></polyline>
							</svg>
						</a>
						<a href="#how-to-use" class="hero-secondary-btn">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="12" y1="5" x2="12" y2="19"></line>
								<polyline points="19 12 12 19 5 12"></polyline>
							</svg>
							<span>Step-by-Step Instructions</span>
						</a>
						<a href="#video-tutorial" class="hero-secondary-btn">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
							</svg>
							<span>Video Tutorial</span>
						</a>
					</div>

					<div class="workspace-hint">
						<span class="workspace-label">Primary Workspace:</span>
						<span class="workspace-value">{guide.workspace}</span>
					</div>
				</div>
			</div>
		</header>

		<!-- Jump Links Navigation Strip -->
		<nav class="guide-toc-strip" aria-label="Table of contents">
			<div class="guide-container">
				<div class="toc-pills">
					<a href="#video-tutorial" class="toc-pill">Video Tutorial</a>
					<a href="#overview" class="toc-pill">Overview</a>
					<a href="#anatomy" class="toc-pill">Tool Anatomy</a>
					<a href="#how-to-use" class="toc-pill">How to Use</a>
					<a href="#pro-tips" class="toc-pill">Pro Tips</a>
					<a href="#shortcuts" class="toc-pill">Shortcuts</a>
					<a href="#faq" class="toc-pill">FAQ</a>
					{relatedGuides.length > 0 && <a href="#related" class="toc-pill">Related Tools</a>}
				</div>
			</div>
		</nav>

		<!-- Content Layout -->
		<div class="guide-container">
			<div class="guide-layout">
				<!-- Main Content Body -->
				<article class="guide-content">
					<!-- Video Tutorial Section -->
					<section id="video-tutorial" class="content-block">
						<div class="section-heading">
							<div class="section-eyebrow">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="red-icon" aria-hidden="true">
									<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
								</svg>
								<span>VIDEO WALKTHROUGH & TUTORIAL</span>
							</div>
							<h2>Watch How to Use the {guide.title}</h2>
							<p>
								Watch the visual demonstration of the {guide.title} in action, or follow the complete
								step-by-step instructions below.
							</p>
						</div>

						<!-- Responsive YouTube Player or Placeholder -->
						<YouTubeEmbed
							videoId={guide.youtubeVideoId}
							videoUrl={guide.youtubeUrl}
							title={guide.title}
							toolId={guide.id}
						/>
					</section>

					<!-- Overview Section -->
					<section id="overview" class="content-block">
						<div class="section-heading">
							<span class="section-tag">OVERVIEW</span>
							<h2>What is the {guide.title}?</h2>
						</div>
						<div class="narrative-text">
							<p>{guide.overview}</p>
						</div>

						<!-- When to Use Checklist -->
						<div class="when-to-use-box">
							<h3 class="when-to-use-title">When and Why to Use This Tool</h3>
							<ul class="checklist">
								{guide.whenToUse.map((item) => (
									<li>
										<span class="check-icon" aria-hidden="true">
											<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
												<polyline points="20 6 9 17 4 12"></polyline>
											</svg>
										</span>
										<span>{item}</span>
									</li>
								))}
							</ul>
						</div>
					</section>

					<!-- Tool Anatomy & UI Features -->
					<section id="anatomy" class="content-block">
						<div class="section-heading">
							<span class="section-tag">UI BREAKDOWN</span>
							<h2>Visual Anatomy & Interface Controls</h2>
							<p>Understanding the cursor feedback, indicators, and controls of the {guide.title}.</p>
						</div>

						<div class="anatomy-grid">
							{guide.anatomy.map((item) => (
								<div class="anatomy-card">
									<div class="anatomy-card-top">
										<span class="anatomy-dot" aria-hidden="true"></span>
										<h3 class="anatomy-title">{item.feature}</h3>
									</div>
									<p class="anatomy-desc">{item.explanation}</p>
								</div>
							))}
						</div>
					</section>

					<!-- Step-by-Step Instructions -->
					<section id="how-to-use" class="content-block">
						<div class="section-heading">
							<span class="section-tag">STEP-BY-STEP WORKFLOW</span>
							<h2>How to Use the {guide.title}</h2>
							<p>Follow these numbered steps to master the tool quickly and avoid common pitfalls.</p>
						</div>

						<div class="steps-timeline">
							{guide.steps.map((step) => (
								<div class="step-card" id={`step-${step.stepNumber}`}>
									<div class="step-number-col">
										<span class="step-number">{step.stepNumber}</span>
										<div class="step-line" aria-hidden="true"></div>
									</div>

									<div class="step-body">
										<div class="step-title-row">
											<h3 class="step-title">{step.title}</h3>
											{step.shortcutBadge && (
												<span class="step-badge">
													<kbd>{step.shortcutBadge}</kbd>
												</span>
											)}
										</div>
										<p class="step-desc">{step.description}</p>
										{step.tip && (
											<div class="step-tip-callout">
												<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tip-icon" aria-hidden="true">
													<circle cx="12" cy="12" r="10"></circle>
													<line x1="12" y1="16" x2="12" y2="12"></line>
													<line x1="12" y1="8" x2="12.01" y2="8"></line>
												</svg>
												<span><strong>Pro Tip:</strong> {step.tip}</span>
											</div>
										)}
									</div>
								</div>
							))}
						</div>
					</section>

					<!-- Power-User Pro Tips -->
					<section id="pro-tips" class="content-block">
						<div class="section-heading">
							<span class="section-tag">PRO EDITING TIPS</span>
							<h2>Power-User Workflow Secrets</h2>
							<p>Expert techniques to boost editing speed and maintain clean, professional timelines.</p>
						</div>

						<div class="tips-grid">
							{guide.quickTips.map((tip) => (
								<div class="tip-card">
									<div class="tip-icon-box" aria-hidden="true">
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
										</svg>
									</div>
									<p class="tip-text">{tip}</p>
								</div>
							))}
						</div>
					</section>

					<!-- Keyboard Shortcuts Reference -->
					<section id="shortcuts" class="content-block">
						<div class="section-heading">
							<span class="section-tag">KEYBOARD REFERENCE</span>
							<h2>Keyboard Shortcuts</h2>
							<p>Speed up your edits without reaching for the mouse.</p>
						</div>

						<div class="shortcuts-table-wrapper">
							<table class="shortcuts-table">
								<thead>
									<tr>
										<th>Action</th>
										<th>Key / Shortcut</th>
										<th>Platform Modifier</th>
									</tr>
								</thead>
								<tbody>
									{guide.keyboardShortcuts.map((sc) => (
										<tr>
											<td class="action-cell">
												<strong>{sc.action}</strong>
											</td>
											<td class="key-cell">
												<kbd>{sc.modifier ? `${sc.modifier} + ` : ''}{sc.key}</kbd>
											</td>
											<td class="note-cell">
												{sc.modifier ? (
													<span>Mac: <code>{sc.modifier.replace('Cmd/Ctrl', '⌘').replace('Alt/Option', '⌥')}</code> &bull; Win: <code>{sc.modifier.replace('Cmd/Ctrl', 'Ctrl').replace('Alt/Option', 'Alt')}</code></span>
												) : (
													<span>Single Keypress</span>
												)}
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>

					<!-- Frequently Asked Questions -->
					<section id="faq" class="content-block">
						<div class="section-heading">
							<span class="section-tag">TROUBLESHOOTING & FAQ</span>
							<h2>Frequently Asked Questions</h2>
							<p>Common questions about using the {guide.title}.</p>
						</div>

						<div class="faq-list">
							{guide.faq.map((item) => (
								<div class="faq-item">
									<h3 class="faq-question">{item.question}</h3>
									<p class="faq-answer">{item.answer}</p>
								</div>
							))}
						</div>
					</section>

					<!-- Next / Prev Guide Navigation -->
					<div class="prev-next-nav">
						<a href={`/guides/${prevGuide.id}/`} class="nav-card prev-card">
							<span class="nav-direction">&larr; Previous Tool Guide</span>
							<span class="nav-title">{prevGuide.title}</span>
						</a>
						<a href={`/guides/${nextGuide.id}/`} class="nav-card next-card">
							<span class="nav-direction">Next Tool Guide &rarr;</span>
							<span class="nav-title">{nextGuide.title}</span>
						</a>
					</div>

					<!-- Related Guides -->
					{relatedGuides.length > 0 && (
						<section id="related" class="content-block related-section">
							<div class="section-heading">
								<span class="section-tag">COMPLEMENTARY TOOLS</span>
								<h2>Related Editing Tools</h2>
							</div>

							<div class="related-grid">
								{relatedGuides.map((rel) => (
									<a href={`/guides/${rel.id}/`} class="related-card">
										<div class="related-icon-box">
											<ToolIcon name={rel.icon} size={20} />
										</div>
										<div class="related-body">
											<div class="related-title-row">
												<span class="related-title">{rel.title}</span>
												{rel.shortcut && <kbd class="related-key">{rel.shortcut}</kbd>}
											</div>
											<p class="related-desc">{rel.subtitle}</p>
										</div>
									</a>
								))}
							</div>
						</section>
					)}
				</article>

				<!-- Floating Sticky Sidebar -->
				<aside class="guide-sidebar">
					<div class="sidebar-sticky-wrapper">
						<!-- Quick Tool Info Box -->
						<div class="sidebar-card">
							<h4 class="sidebar-card-title">Tool Specifications</h4>
							<div class="spec-row">
								<span class="spec-label">Tool:</span>
								<span class="spec-value">{guide.title}</span>
							</div>
							{guide.shortcut && (
								<div class="spec-row">
									<span class="spec-label">Shortcut:</span>
									<span class="spec-value"><kbd>{guide.shortcut}</kbd></span>
								</div>
							)}
							<div class="spec-row">
								<span class="spec-label">Workspace:</span>
								<span class="spec-value">{guide.workspace}</span>
							</div>
							<div class="spec-row">
								<span class="spec-label">Category:</span>
								<span class="spec-value">{guide.categoryLabel}</span>
							</div>
							<div class="spec-row">
								<span class="spec-label">Difficulty:</span>
								<span class="spec-value">{guide.difficulty}</span>
							</div>
							<div class="spec-row">
								<span class="spec-label">Privacy:</span>
								<span class="spec-value text-green">100% On-Device</span>
							</div>

							<div class="sidebar-cta-wrapper">
								<a href="/editor/" class="sidebar-launch-btn">
									<span>Open Editor</span>
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="9 18 15 12 9 6"></polyline>
									</svg>
								</a>
							</div>
						</div>

						<!-- All Tools Quick Links -->
						<div class="sidebar-card">
							<h4 class="sidebar-card-title">All Tool Guides</h4>
							<ul class="sidebar-tool-list">
								{TOOL_GUIDES.map((t) => (
									<li>
										<a
											href={`/guides/${t.id}/`}
											class={`sidebar-tool-link ${t.id === guide.id ? 'is-active' : ''}`}
										>
											<span class="sidebar-tool-icon">
												<ToolIcon name={t.icon} size={15} />
											</span>
											<span class="sidebar-tool-name">{t.title}</span>
											{t.shortcut && <kbd class="sidebar-shortcut-badge">{t.shortcut}</kbd>}
										</a>
									</li>
								))}
							</ul>
							<div class="sidebar-back-box">
								<a href="/guides/" class="sidebar-all-guides-link">&larr; View All Guides Directory</a>
							</div>
						</div>
					</div>
				</aside>
			</div>
		</div>

		<!-- Bottom Launch CTA Section -->
		<section class="guide-cta-section">
			<div class="guide-container">
				<div class="cta-banner">
					<div class="cta-content">
						<h2>Ready to Try the {guide.title}?</h2>
