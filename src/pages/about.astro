---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BuyMeACoffee from '../components/BuyMeACoffee.astro';

const seoTitle = 'About Us — The Free Video Editor';
const seoDescription =
	'Learn about The Free Video Editor, our mission to build a completely free, private, browser-native video editor with zero cloud tracking and zero watermarks.';
---

<Layout
	title={seoTitle}
	description={seoDescription}
	canonicalUrl="https://thefreevideoeditor.com/about/"
>
	<Header />

	<main class="page-main">
		<div class="page-container">
			<div class="page-header">
				<div class="eyebrow-badge">
					<span class="pulsing-dot" aria-hidden="true"></span>
					<span>OUR MISSION & ARCHITECTURE</span>
				</div>
				<h1 class="page-title">About The Free Video Editor</h1>
				<p class="page-lead">
					Empowering creators with a zero-cost, private, desktop-grade video editor built natively
					for the modern open web.
				</p>
			</div>

			<article class="content-body">
				<section class="content-section">
					<h2>Who We Are</h2>
					<p>
						<strong>The Free Video Editor</strong> is an open-initiative multimedia editing platform
						created to address a growing problem in creative software: expensive subscriptions,
						forced cloud uploads, artificial export watermarks, and invasive tracking of user media.
					</p>
					<p>
						We believe professional video creation tools should be accessible to everyone —
						students, teachers, independent filmmakers, digital marketers, and casual content
						creators — without barriers, paywalls, or compromising on user privacy.
					</p>
				</section>

				<section class="content-section">
					<h2>Why In-Browser & Why On-Device?</h2>
					<p>
						Traditional web video editors take your private footage, upload it over slow connections
						to remote servers, queue it in rendering farms, and charge you subscription fees or
						cloud credits for basic export formats.
					</p>
					<p>
						The Free Video Editor changes everything through <strong>Client-Side Processing</strong>
						:
					</p>
					<ul class="features-list">
						<li>
							<strong>WebCodecs API:</strong> Direct hardware-accelerated video decoding and
							encoding inside your browser at 60 FPS, with full 4K and 8K support.
						</li>
						<li>
							<strong>Zero Cloud Uploads:</strong> Your video clips, audio tracks, and images remain
							completely inside your device’s local browser memory and sandbox.
						</li>
						<li>
							<strong>WebGL2 Shaders:</strong> GPU-accelerated real-time color correction,
							green-screen chroma keying, LUT applications, masking, and transitions.
						</li>
						<li>
							<strong>On-Device AI & Smart Cut:</strong> Automatic Voice Activity Detection (VAD)
							silence trimming, offline Whisper speech-to-text captions, and subpixel motion
							tracking executed completely on your device's CPU and WebGPU.
						</li>
					</ul>
				</section>

				<section class="content-section">
					<h2>Our Core Values</h2>
					<div class="cards-grid">
						<div class="card">
							<div class="card-icon">
								<svg
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
								</svg>
							</div>
							<h3>100% Privacy by Design</h3>
							<p>
								We do not store, view, or process your media on any server. What you film and edit
								is strictly between you and your computer.
							</p>
						</div>

						<div class="card">
							<div class="card-icon">
								<svg
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="12" cy="12" r="10"></circle>
									<path d="M12 6v6l4 2"></path>
								</svg>
							</div>
							<h3>Zero Watermarks & Paywalls</h3>
							<p>
								Full 1080p, 4K, and 60 FPS rendering with no brand logos stamped onto your art, no
								credit card required, and no hidden trial periods.
							</p>
						</div>

						<div class="card">
							<div class="card-icon">
								<svg
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
								</svg>
							</div>
							<h3>Instant Accessibility</h3>
							<p>
								No multi-gigabyte installers, no driver mismatches, and no administrator
								permissions. Launch on Chrome, Safari, Edge, Firefox, or Chromebooks.
							</p>
						</div>
					</div>
				</section>

				<section class="content-section">
					<h2>Support Our Independent Mission</h2>
					<p>
						We are building The Free Video Editor as a truly free alternative to bloated,
						privacy-invasive desktop apps and expensive cloud subscriptions. If this editor saves
						you time and money, consider buying us a coffee! Every coffee helps keep the servers
						running and funds development of professional codecs and features.
					</p>
					<BuyMeACoffee variant="card" />
				</section>

				<section class="cta-box">
					<h2>Ready to start creating?</h2>
					<p>Experience fast, private, multi-track video editing right now.</p>
					<a href="/editor/" class="btn-primary">
						Launch The Editor — It's Free
					</a>
				</section>
			</article>
		</div>
	</main>

	<Footer currentPage="/about/" />
</Layout>

<style>
	.page-main {
		min-height: 100vh;
		background: #070709;
		color: #e2e8f0;
		padding: 7rem 1.5rem 5rem;
	}

	.page-container {
		max-width: 52rem;
		margin: 0 auto;
	}

	.page-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.eyebrow-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 5px 14px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #94a3b8;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		margin-bottom: 1.25rem;
	}

	.pulsing-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #38bdf8;
		box-shadow: 0 0 8px #38bdf8;
	}

	.page-title {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		color: #ffffff;
		margin: 0 0 1rem 0;
		line-height: 1.15;
	}

	.page-lead {
		font-size: 1.15rem;
		color: #94a3b8;
		line-height: 1.6;
		margin: 0 auto;
		max-width: 42rem;
	}

	.content-body {
		display: flex;
		flex-direction: column;
		gap: 2.75rem;
	}

	.content-section h2 {
		font-size: 1.6rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #f8fafc;
		margin: 0 0 1rem 0;
	}

	.content-section p {
		color: #94a3b8;
		line-height: 1.75;
		font-size: 1rem;
		margin: 0 0 1rem 0;
	}

	.features-list {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.features-list li {
		position: relative;
		padding-left: 1.75rem;
		color: #cbd5e1;
		line-height: 1.6;
		font-size: 0.95rem;
	}

	.features-list li::before {
		content: '✓';
		position: absolute;
		left: 0;
		top: 0;
		color: #38bdf8;
		font-weight: bold;
	}

	.cards-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.card {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 1.5rem;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.card:hover {
		border-color: rgba(56, 189, 248, 0.3);
		transform: translateY(-2px);
	}

	.card-icon {
		display: inline-flex;
		padding: 10px;
		border-radius: 8px;
		background: rgba(56, 189, 248, 0.1);
		color: #38bdf8;
		margin-bottom: 1rem;
	}

	.card h3 {
		font-size: 1.1rem;
		color: #ffffff;
		margin: 0 0 0.5rem 0;
		font-weight: 600;
	}

	.card p {
		font-size: 0.88rem;
		color: #94a3b8;
		line-height: 1.6;
		margin: 0;
	}

	.cta-box {
		margin-top: 2rem;
		background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(168, 85, 247, 0.06));
		border: 1px solid rgba(56, 189, 248, 0.2);
		border-radius: 16px;
		padding: 2.5rem 2rem;
		text-align: center;
	}

	.cta-box h2 {
		font-size: 1.75rem;
		color: #ffffff;
		margin: 0 0 0.5rem 0;
	}

	.cta-box p {
		color: #94a3b8;
		margin: 0 0 1.5rem 0;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 2rem;
		border-radius: 9999px;
		background: #ededed;
		color: #090909;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
		box-shadow: 0 0 20px rgba(255, 255, 255, 0.15);
	}

	.btn-primary:hover {
		background: #ffffff;
		box-shadow: 0 0 30px rgba(56, 189, 248, 0.3);
		transform: scale(1.02);
	}
</style>
