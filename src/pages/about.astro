---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BuyMeACoffee from '../components/BuyMeACoffee.astro';

const seoTitle = 'About Us — The Free Video Editor';
const seoDescription =
	'Learn about The Free Video Editor, our mission to build a completely free, private, browser-native video editor with zero cloud tracking and zero watermarks.';

const aboutJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	name: 'About The Free Video Editor',
	description: seoDescription,
	url: 'https://thefreevideoeditor.com/about/',
	mainEntity: {
		'@type': 'Organization',
		name: 'The Free Video Editor',
		url: 'https://thefreevideoeditor.com/',
		logo: 'https://thefreevideoeditor.com/favicon.svg',
		founder: {
			'@type': 'Person',
			name: 'Gajanan Palepwad',
			jobTitle: 'Founder & Principal Systems Architect',
			sameAs: ['https://github.com/GajananPalepwad']
		},
		parentOrganization: {
			'@type': 'Organization',
			name: 'BeeStack',
			url: 'https://beestack.in'
		}
	}
};
---

<Layout
	title={seoTitle}
	description={seoDescription}
	canonicalUrl="https://thefreevideoeditor.com/about/"
>
	<script type="application/ld+json" set:html={JSON.stringify(aboutJsonLd)} slot="head"></script>
	<Header />

	<main class="page-main">
		<div class="page-container">
			<div class="page-header">
				<div class="eyebrow-badge">
					<span class="pulsing-dot" aria-hidden="true"></span>
					<span>OUR MISSION & ARCHITECTURE</span>
				</div>
				<h1 class="page-title">About The Free Video Editor</h1>
				<p class="page-lead">
					Empowering creators with a zero-cost, private, desktop-grade video editor built natively
					for the modern open web.
				</p>
			</div>

			<article class="content-body">
				<section class="content-section">
					<h2>Who We Are</h2>
					<p>
						<strong>The Free Video Editor</strong> is an open-initiative multimedia editing platform
						created to address a growing problem in creative software: expensive subscriptions,
						forced cloud uploads, artificial export watermarks, and invasive tracking of user media.
					</p>
					<p>
						We believe professional video creation tools should be accessible to everyone —
						students, teachers, independent filmmakers, digital marketers, and casual content
						creators — without barriers, paywalls, or compromising on user privacy.
					</p>
				</section>

				<section class="content-section">
					<h2>Why In-Browser & Why On-Device?</h2>
					<p>
						Traditional web video editors take your private footage, upload it over slow connections
						to remote servers, queue it in rendering farms, and charge you subscription fees or
						cloud credits for basic export formats.
					</p>
					<p>
						The Free Video Editor changes everything through <strong>Client-Side Processing</strong>
						:
					</p>
					<ul class="features-list">
						<li>
							<strong>WebCodecs API:</strong> Direct hardware-accelerated video decoding and
							encoding inside your browser at 60 FPS, with full 4K and 8K support.
						</li>
						<li>
							<strong>Zero Cloud Uploads:</strong> Your video clips, audio tracks, and images remain
							completely inside your device’s local browser memory and sandbox.
						</li>
						<li>
							<strong>WebGL2 Shaders:</strong> GPU-accelerated real-time color correction,
							green-screen chroma keying, LUT applications, masking, and transitions.
						</li>
						<li>
							<strong>On-Device AI & Smart Cut:</strong> Automatic Voice Activity Detection (VAD)
							silence trimming, offline Whisper speech-to-text captions, and subpixel motion
							tracking executed completely on your device's CPU and WebGPU.
						</li>
					</ul>
				</section>

				<section class="content-section">
					<h2>Our Core Values</h2>
					<div class="cards-grid">
						<div class="card">
							<div class="card-icon">
								<svg
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
								</svg>
							</div>
							<h3>100% Privacy by Design</h3>
							<p>
								We do not store, view, or process your media on any server. What you film and edit
								is strictly between you and your computer.
							</p>
						</div>

						<div class="card">
							<div class="card-icon">
								<svg
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="12" cy="12" r="10"></circle>
									<path d="M12 6v6l4 2"></path>
								</svg>
							</div>
							<h3>Zero Watermarks & Paywalls</h3>
							<p>
								Full 1080p, 4K, and 60 FPS rendering with no brand logos stamped onto your art, no
								credit card required, and no hidden trial periods.
							</p>
						</div>

						<div class="card">
							<div class="card-icon">
								<svg
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
								</svg>
							</div>
							<h3>Instant Accessibility</h3>
							<p>
								No multi-gigabyte installers, no driver mismatches, and no administrator
								permissions. Launch on Chrome, Safari, Edge, Firefox, or Chromebooks.
							</p>
						</div>
					</div>
				</section>

				<section class="content-section" id="founder">
					<h2>Founder & Engineering Leadership</h2>
					<div class="author-card">
						<div class="author-avatar" aria-hidden="true">
							<span class="author-initials">GP</span>
						</div>
						<div class="author-info">
							<h3 class="author-name">Gajanan Palepwad</h3>
							<p class="author-role">Founder & Lead Systems Architect &middot; BeeStack</p>
							<p class="author-bio">
								Gajanan is a software engineer and multimedia systems developer specializing in
								high-performance web technologies, WebCodecs, WebGL2/WebGPU shader pipelines, and
								client-side artificial intelligence. With extensive experience building real-time
								browser applications and open-source developer tooling, he founded The Free Video
								Editor under
								<strong>BeeStack</strong> to bring studio-grade non-linear video editing to every
								creator with zero cloud data collection and zero subscription costs.
							</p>
							<div class="author-links">
								<a
									href="https://github.com/GajananPalepwad"
									target="_blank"
									rel="noopener noreferrer"
									class="author-link"
								>
									<svg
										width="16"
										height="16"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
									</svg>
									<span>GitHub Profile</span>
								</a>
								<a href="mailto:contact@beestack.in" class="author-link">
									<svg
										width="16"
										height="16"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
										<polyline points="22,6 12,13 2,6"></polyline>
									</svg>
									<span>contact@beestack.in</span>
								</a>
							</div>
						</div>
					</div>
				</section>

				<section class="content-section" id="editorial-standards">
					<h2>Editorial Standards & Technical Verification</h2>
					<p>
						Every tutorial, workflow guide, and keyboard reference published on The Free Video
						Editor is developed under rigorous engineering and editorial quality controls:
					</p>
					<ul class="features-list">
						<li>
							<strong>Hardware Benchmarking:</strong> All guides (such as 4K 60fps export, 3-way
							color grading, and Whisper subtitle generation) are tested and verified across actual
							hardware environments—including Apple Silicon (M1/M2/M3/M4), Intel/AMD discrete GPUs,
							Windows laptops, and ChromeOS devices.
						</li>
						<li>
							<strong>W3C Web Standards Alignment:</strong> Our documentation reflects living
							browser standards including W3C WebCodecs, WebGL2, WebAudio DSP, and WebGPU specs to
							ensure advice remains accurate, efficient, and forward-compatible.
						</li>
						<li>
							<strong>Real-World Production Scenarios:</strong> Step-by-step procedures are verified
							against real creator workflows—ranging from YouTube 16:9 widescreen vlogs to TikTok
							9:16 vertical shorts and podcast dialogue editing.
						</li>
						<li>
							<strong>Human-Curated Editorial Oversight:</strong> Our team directly researches,
							writes, and reviews all educational documentation to prevent misleading or superficial
							content.
						</li>
					</ul>
				</section>

				<section class="content-section" id="curation-and-maintenance">
					<h2>Ongoing Platform Curation & Maintenance</h2>
					<p>
						The Free Video Editor is actively developed and maintained with continuous quality
						updates, community issue triage, and browser compatibility patches:
					</p>
					<div class="cards-grid">
						<div class="card">
							<div class="card-icon">
								<svg
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<polyline points="16 18 22 12 16 6"></polyline>
									<polyline points="8 6 2 12 8 18"></polyline>
								</svg>
							</div>
							<h3>Open-Source & Transparent</h3>
							<p>
								Codebase transparently hosted on GitHub with open issue tracking, reproducible test
								suites, and public pull request reviews.
							</p>
						</div>
						<div class="card">
							<div class="card-icon">
								<svg
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="12" cy="12" r="10"></circle>
									<polyline points="12 6 12 12 14 14"></polyline>
								</svg>
							</div>
							<h3>Continuous Evolution</h3>
							<p>
								Weekly updates delivering new codecs, Whisper model optimizations, timeline UI
								refinements, and performance improvements.
							</p>
						</div>
						<div class="card">
							<div class="card-icon">
								<svg
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
									<circle cx="9" cy="7" r="4"></circle>
									<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
									<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
								</svg>
							</div>
							<h3>Community-Driven</h3>
							<p>
								Active Discord community and feedback channels where video editors submit feature
								requests, report anomalies, and shape our roadmap.
							</p>
						</div>
					</div>
				</section>

				<section class="content-section">
					<h2>Support Our Independent Mission</h2>
					<p>
						We are building The Free Video Editor as a truly free alternative to bloated,
						privacy-invasive desktop apps and expensive cloud subscriptions. If this editor saves
						you time and money, consider buying us a coffee! Every coffee helps keep the servers
						running and funds development of professional codecs and features.
					</p>
					<BuyMeACoffee variant="card" />
				</section>

				<section class="cta-box">
					<h2>Ready to start creating?</h2>
					<p>Experience fast, private, multi-track video editing right now.</p>
					<a href="/editor/" class="btn-primary">
						Launch The Editor — It's Free
					</a>
				</section>
			</article>
		</div>
	</main>

	<Footer currentPage="/about/" />
</Layout>

<style>
	.page-main {
		min-height: 100vh;
		background: #070709;
		color: #e2e8f0;
		padding: 7rem 1.5rem 5rem;
	}

	.page-container {
		max-width: 52rem;
		margin: 0 auto;
	}

	.page-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.eyebrow-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 5px 14px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #94a3b8;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		margin-bottom: 1.25rem;
	}

	.pulsing-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #38bdf8;
		box-shadow: 0 0 8px #38bdf8;
	}

	.page-title {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		color: #ffffff;
		margin: 0 0 1rem 0;
		line-height: 1.15;
	}

	.page-lead {
		font-size: 1.15rem;
		color: #94a3b8;
		line-height: 1.6;
		margin: 0 auto;
		max-width: 42rem;
	}

	.content-body {
		display: flex;
		flex-direction: column;
		gap: 2.75rem;
	}

	.content-section h2 {
		font-size: 1.6rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #f8fafc;
		margin: 0 0 1rem 0;
	}

	.content-section p {
		color: #94a3b8;
		line-height: 1.75;
		font-size: 1rem;
		margin: 0 0 1rem 0;
	}

	.features-list {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.features-list li {
		position: relative;
		padding-left: 1.75rem;
		color: #cbd5e1;
		line-height: 1.6;
		font-size: 0.95rem;
	}

	.features-list li::before {
		content: '✓';
		position: absolute;
		left: 0;
		top: 0;
		color: #38bdf8;
		font-weight: bold;
	}

	.cards-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.card {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 1.5rem;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.card:hover {
		border-color: rgba(56, 189, 248, 0.3);
		transform: translateY(-2px);
	}

	.card-icon {
		display: inline-flex;
		padding: 10px;
		border-radius: 8px;
		background: rgba(56, 189, 248, 0.1);
		color: #38bdf8;
		margin-bottom: 1rem;
	}

	.card h3 {
		font-size: 1.1rem;
		color: #ffffff;
		margin: 0 0 0.5rem 0;
		font-weight: 600;
	}

	.card p {
		font-size: 0.88rem;
		color: #94a3b8;
		line-height: 1.6;
		margin: 0;
	}

	.cta-box {
		margin-top: 2rem;
		background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(168, 85, 247, 0.06));
		border: 1px solid rgba(56, 189, 248, 0.2);
		border-radius: 16px;
		padding: 2.5rem 2rem;
		text-align: center;
	}

	.cta-box h2 {
		font-size: 1.75rem;
		color: #ffffff;
		margin: 0 0 0.5rem 0;
	}

	.cta-box p {
		color: #94a3b8;
		margin: 0 0 1.5rem 0;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 2rem;
		border-radius: 9999px;
		background: #ededed;
		color: #090909;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
		box-shadow: 0 0 20px rgba(255, 255, 255, 0.15);
	}

	.btn-primary:hover {
		background: #ffffff;
		box-shadow: 0 0 30px rgba(56, 189, 248, 0.3);
		transform: scale(1.02);
	}

	.author-card {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 14px;
		padding: 1.75rem;
		margin-top: 1rem;
	}

	@media (max-width: 640px) {
		.author-card {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}
	}

	.author-avatar {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: linear-gradient(135deg, #38bdf8, #818cf8);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		box-shadow: 0 0 16px rgba(56, 189, 248, 0.3);
	}

	.author-initials {
		font-weight: 700;
		font-size: 1.25rem;
		color: #09090b;
		letter-spacing: -0.02em;
	}

	.author-info {
		flex: 1;
	}

	.author-name {
		font-size: 1.3rem;
		color: #ffffff;
		font-weight: 600;
		margin: 0 0 0.25rem 0;
	}

	.author-role {
		font-size: 0.85rem;
		color: #38bdf8;
		font-family: var(--font-mono);
		margin: 0 0 0.85rem 0;
	}

	.author-bio {
		color: #94a3b8;
		font-size: 0.92rem;
		line-height: 1.65;
		margin: 0 0 1.25rem 0 !important;
	}

	.author-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	@media (max-width: 640px) {
		.author-links {
			justify-content: center;
		}
	}

	.author-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 14px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #cbd5e1;
		font-size: 0.82rem;
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.author-link:hover {
		background: rgba(255, 255, 255, 0.1);
		color: #ffffff;
		border-color: rgba(56, 189, 248, 0.4);
	}
</style>
