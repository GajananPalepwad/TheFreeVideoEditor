---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeaturesShowcase from '../components/FeaturesShowcase.astro';
import BuyMeACoffee from '../components/BuyMeACoffee.astro';
import Contributors from '../components/Contributors.astro';

const seoTitle =
	'The Free Video Editor — Free Online Video Editor & AI Video Editor in Your Browser';
const seoDescription =
	'The Free Video Editor is a fast, free online video editor and AI video editor in your browser. Trim silences with Smart Cut, generate on-device Whisper captions, edit 4K multi-track video, and export without watermarks or cloud uploads.';

const faqItems = [
	{
		question: 'How does Smart Cut silence removal work?',
		answer:
			'Smart Cut uses on-device Voice Activity Detection (VAD) and spectral energy analysis to automatically scan audio tracks for pauses, dead air, and breaths. It then automatically ripple-trims those silent sections from both video and audio tracks simultaneously, keeping media in frame-accurate sync with customizable speech padding and non-destructive sequence export.'
	},
	{
		question: 'Can I transcribe subtitles and trim silences with AI for free and offline?',
		answer:
			'Yes. Both the Whisper AI speech-to-text engine and the Smart Cut silence trimmer execute 100% locally in your browser using WebGPU and WebAssembly. Your media files are never uploaded to remote servers or cloud queues, and once cached, the editor functions completely offline with zero subscriptions, paywalls, or watermarks.'
	},
	{
		question: 'How to become a video editor?',
		answer:
			'To become a video editor, learn core storytelling, pacing, three-point cuts, and audio mixing. Practice editing raw footage using browser tools like The Free Video Editor to master keyboard shortcuts and multi-track timelines. Build a portfolio of YouTube edits or short films, and learn interchange formats (OTIO, FCPXML) to prepare for professional video editor jobs.'
	},
	{
		question: 'What is the best video editor?',
		answer:
			'The best video editor depends on your workflow. For Hollywood studios, DaVinci Resolve and Premiere Pro lead the industry. For fast, privacy-first editing in the browser without subscriptions or downloads, The Free Video Editor is widely praised as the best video editor, offering 4K WebCodecs timeline playback, AI captions, and zero cloud uploads.'
	},
	{
		question: 'How much does a video editor cost?',
		answer:
			'A video editor can cost from $0 up to $30–$50 per month for subscriptions like Premiere Pro, or $299 for one-time licenses. Many freemium apps charge for cloud credits or export resolutions. In contrast, The Free Video Editor is 100% free with no subscriptions, no paywalls, and no export watermarks.'
	},
	{
		question: 'Is The Free Video Editor truly a video editor free of charge?',
		answer:
			'Yes. The Free Video Editor is 100% free. We never watermark exports, restrict timeline track counts, or paywall features. You get an unrestricted video editor free for personal and commercial projects.'
	},
	{
		question: 'How does it compare to CapCut video editor or Canva video editor?',
		answer:
			'While CapCut video editor and Canva video editor process files on cloud servers, The Free Video Editor runs entirely in your browser using WebCodecs and WebGL2. Files stay on your device and exports render locally with zero cloud queues.'
	},
	{
		question: 'Can I use it on Windows, macOS, Linux, and Chromebooks?',
		answer:
			'Yes. As a web application, it works across Windows, macOS, Linux, and ChromeOS. Whether you need a reliable windows video editor or a lightweight Chromebook editor with desktop power, it delivers smooth timeline playback on any modern system.'
	}
];

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer
		}
	}))
};
---

<Layout title={seoTitle} description={seoDescription}>
	<!-- FAQ Structured Data (JSON-LD) for Search Engine Rich Snippets -->
	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
	<div class="home-wrapper" id="home-wrapper">
		<!-- Top Navigation Header with MPA Links (About, Privacy, Terms, Contact) -->
		<Header />

		<!-- Hero Section -->
		<section class="home-hero" id="home-hero">
			<!-- Ambient cosmic lighting -->
			<div class="ambient-glow ambient-glow-1" aria-hidden="true"></div>
			<div class="ambient-glow ambient-glow-2" aria-hidden="true"></div>
			<div class="grid-overlay" aria-hidden="true"></div>

			<!-- Interactive Antigravity Canvas (upward floating physics particles) -->
			<canvas id="antigravity-canvas" class="antigravity-canvas" aria-hidden="true"></canvas>

			<!-- Hero Content with Zero-G Levitation -->
			<div class="home-content" id="home-content">
				<div class="home-eyebrow-badge">
					<span class="pulsing-beacon" aria-hidden="true"></span>
					<span class="eyebrow-text">FREE · PRIVATE · IN YOUR BROWSER</span>
				</div>

				<h1 class="hero-title">
					The <span class="highlight-title">Free</span> Video Editor
				</h1>

				<p class="home-description">
					Edit videos in your browser. Free to use, with your files staying on your device.
				</p>

				<div class="cta-wrapper">
					<a class="home-cta" href="/editor">
						<span>Open the editor</span>
						<svg
							class="cta-arrow"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
					<BuyMeACoffee variant="button" text="Buy me a coffee" className="hero-bmc-btn" />
				</div>

				<p class="home-note">
					<svg
						class="shield-icon"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
					</svg>
					No upload. No account. Your files stay on this device.
				</p>
			</div>
			<Contributors />
		</section>

		<!-- Complete Pro Feature Suite Showcase -->
		<FeaturesShowcase />

		<!-- SEO Informational Article Section -->
		<article class="home-seo-article" id="about-section">
			<div class="seo-container">
				<!-- Section 1 -->
				<section class="seo-block">
					<h2 class="seo-heading">
						The Modern Browser-Based Video Editor: Fast, Private, and Watermark-Free
					</h2>
					<p class="seo-paragraph">
						In the fast-moving world of digital media, creators, educators, and social media
						strategists demand an agile <strong>video editor</strong> that operates without
						friction. Historically, video editing required downloading multi-gigabyte software or
						uploading private media to slow cloud servers. The Free Video Editor changes this
						paradigm by bringing a full-fledged non-linear <strong>video editor</strong> directly
						into your web browser. Built on WebCodecs, WebAssembly, and hardware-accelerated WebGL2
						rendering, our platform delivers 4K multi-track editing without sending a single byte of
						footage to remote servers.
					</p>
				</section>

				<!-- Section 2 -->
				<section class="seo-block">
					<h2 class="seo-heading">Why Creators Seek the Best Free Video Editor Online</h2>
					<p class="seo-paragraph">
						Finding the <strong>best free video editor</strong> has traditionally meant
						compromising. Many tools claiming to be a <strong>free video editor</strong> enforce
						export watermarks, limit quality, or demand paid subscriptions. Popular web tools like
						the <strong>Canva video editor</strong> or <strong>CapCut video editor</strong> process
						media on remote cloud servers, causing upload delays and potential privacy risks with
						confidential media.
					</p>
					<p class="seo-paragraph">
						The Free Video Editor is designed from first principles as an on-device{' '}
						<strong>online video editor</strong>. Because decoding, compositing, and rendering
						happen locally on your GPU and CPU, you experience zero upload waits. Whether you need a
						responsive <strong>video editor online</strong> for social clips or a complete suite for
						long tutorials, you enjoy an uncompromising desktop-class experience with zero fees and
						zero watermarks.
					</p>
				</section>

				<!-- Section 3 -->
				<section class="seo-block">
					<h2 class="seo-heading">
						Browser Power vs. Desktop Giants: Adobe Video Editor, Movavi, OpenShot, and Windows
					</h2>
					<p class="seo-paragraph">
						When evaluating desktop suites, creators frequently compare the{' '}
						<strong>Adobe video editor</strong> (Premiere Pro),{' '}
						<strong>OpenShot video editor</strong>, <strong>Movavi video editor</strong>, and the
						built-in <strong>Windows video editor</strong> (historically Windows Movie Maker, now{' '}
						<strong>Microsoft video editor</strong> via Clipchamp).
					</p>
					<p class="seo-paragraph">
						While the <strong>Adobe video editor</strong> offers deep functionality, it requires
						expensive subscriptions, heavy disk storage, and high resource overhead. Open-source
						tools like <strong>OpenShot video editor</strong> offer free access but can struggle
						with real-time multi-track playback. Meanwhile, consumer apps like{' '}
						<strong>Movavi video editor</strong> and the default{' '}
						<strong>Microsoft video editor</strong> offer basic cuts but lack nested sequences,
						bezier curves, and custom LUT color grading.
					</p>
					<p class="seo-paragraph">
						The Free Video Editor bridges this divide. It provides standard NLE keyboard shortcuts,
						nested sequences, and professional interchange exports (OTIO, FCPXML, EDL) with zero
						installation. If you are familiar with the <strong>Windows video editor</strong> or
						looking for an agile alternative to <strong>Movavi video editor</strong> or{' '}
						<strong>Adobe video editor</strong>, our <strong>free online video editor</strong>{' '}
						provides immediate timeline control in any modern browser.
					</p>
				</section>

				<!-- Feature Grid -->
				<div class="seo-feature-grid">
					<div class="seo-card">
						<div class="card-icon" aria-hidden="true">
							<svg
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
								<line x1="7" y1="2" x2="7" y2="22"></line>
								<line x1="17" y1="2" x2="17" y2="22"></line>
								<line x1="2" y1="12" x2="22" y2="12"></line>
								<line x1="2" y1="7" x2="7" y2="7"></line>
								<line x1="2" y1="17" x2="7" y2="17"></line>
								<line x1="17" y1="17" x2="22" y2="17"></line>
								<line x1="17" y1="7" x2="22" y2="7"></line>
							</svg>
						</div>
						<h3 class="card-title">Multi-Track NLE Timeline</h3>
						<p class="card-text">
							Stack video, audio, text, and adjustment layers with magnetic snapping, razor cuts,
							ripple edits, and customizable track heights.
						</p>
					</div>

					<div class="seo-card">
						<div class="card-icon" aria-hidden="true">
							<svg
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<circle cx="12" cy="12" r="10"></circle>
								<path d="m10 15 5-3-5-3v6Z"></path>
							</svg>
						</div>
						<h3 class="card-title">Hardware-Accelerated 4K</h3>
						<p class="card-text">
							Decode and composite 4K 60fps media in real time via WebCodecs and WebGL2 shaders with
							zero server buffering or proxy lag.
						</p>
					</div>

					<div class="seo-card">
						<div class="card-icon" aria-hidden="true">
							<svg
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
							</svg>
						</div>
						<h3 class="card-title">Zero Cloud Leakage</h3>
						<p class="card-text">
							Every frame stays confined to your browser sandbox. No server accounts, no cloud sync,
							and zero privacy compromise.
						</p>
					</div>
				</div>

				<!-- Section 4 -->
				<section class="seo-block">
					<h2 class="seo-heading">
						Next-Generation AI Video Editor: Smart Cut Silence Trimming & Whisper Subtitles
					</h2>
					<p class="seo-paragraph">
						Artificial intelligence is revolutionizing video production, but typical cloud AI tools
						introduce privacy risks, slow render queues, and recurring credit subscriptions. The
						Free Video Editor is an intelligent, privacy-first <strong>ai video editor</strong> that
						processes neural workloads directly in your browser using WebGPU and WebAssembly.
					</p>
					<p class="seo-paragraph">
						With our dedicated <strong>AI workspace</strong> and{' '}
						<strong>Smart Cut silence removal</strong> engine, you can automatically scan dialogue
						tracks, detect dead air, and ripple-trim pauses across your timeline with frame-accurate
						audio and video synchronization. Whether editing podcasts, talking-head interviews,
						tutorials, or YouTube jump cuts, Smart Cut eliminates hours of tedious manual cutting in
						seconds with zero cloud latency.
					</p>
					<p class="seo-paragraph">
						Alongside Smart Cut, our integrated <strong>free ai video editor</strong> suite features
						on-device Whisper AI speech-to-text transcription. Generate animated, word-synced
						subtitles and export SRT or WebVTT files without uploading audio or video to third-party
						servers. If you need a private <strong>ai video editor free</strong> of tracking for
						confidential corporate footage, client deliverables, or personal vlogs, our platform
						delivers desktop-grade automation with airtight data privacy.
					</p>
				</section>

				<!-- Section 5 -->
				<section class="seo-block">
					<h2 class="seo-heading">
						Optimized for YouTube Creators, Social Reels, and Modern Pipelines
					</h2>
					<p class="seo-paragraph">
						Content creators producing YouTube videos, TikToks, Instagram Reels, and YouTube Shorts
						require an agile <strong>youtube video editor</strong> with rapid turnaround. The Free
						Video Editor features presets for 16:9 widescreen, 9:16 vertical, 1:1 square, and 4:5
						portrait formats.
					</p>
					<p class="seo-paragraph">
						As a complete <strong>youtube video editor</strong>, it supports instant split-cuts,
						ripple edits, audio scrubbing, keyframe automation, and smooth transitions. Export crisp
						1080p and 4K MP4 or WebM files at 60fps directly to your local drive without render
						queues, server slowdowns, or forced watermarks.
					</p>
				</section>

				<!-- Section 6 -->
				<section class="seo-block">
					<h2 class="seo-heading">
						Building Marketable Skills for Video Editor Jobs and Industry Careers
					</h2>
					<p class="seo-paragraph">
						Video editing remains one of the most in-demand digital media skills. Aspiring editors
						preparing for <strong>video editor jobs</strong> often wonder whether an{' '}
						<strong>online video editor</strong> can prepare them for professional studio roles.
					</p>
					<p class="seo-paragraph">
						The answer is yes. The Free Video Editor is designed around industry-standard NLE
						workflows: three-point editing, ripple and roll trimming, J-cut and L-cut split audio,
						and Premiere-style shortcuts (J-K-L transport, C razor, V selection). Mastering timeline
						organization, easing curves, and color grading here builds transferable skills directly
						applicable to commercial <strong>video editor jobs</strong> in broadcast and social
						video production.
					</p>
				</section>

				<!-- Comparison Table -->
				<section class="seo-block">
					<h2 class="seo-heading">Comparing The Free Video Editor to Conventional Options</h2>
					<div class="table-container">
						<table class="comparison-table">
							<thead>
								<tr>
									<th>Feature / Characteristic</th>
									<th>The Free Video Editor</th>
									<th>Cloud Tools (CapCut / Canva)</th>
									<th>Desktop Suites (Premiere / Movavi)</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>
										<strong>Privacy & Data Leakage</strong>
									</td>
									<td>100% On-Device (Zero Upload)</td>
									<td>Uploads to Third-Party Cloud</td>
									<td>Local (Subject to Cloud Telemetry)</td>
								</tr>
								<tr>
									<td>
										<strong>Pricing & Subscriptions</strong>
									</td>
									<td>100% Free / No Subscriptions</td>
									<td>Freemium / Recurring Credits</td>
									<td>Paid License or Monthly Cost</td>
								</tr>
								<tr>
									<td>
										<strong>Watermark Enforcement</strong>
									</td>
									<td>Never / Completely Clean</td>
									<td>Watermark or End-Card Cards</td>
									<td>Trial Watermarks or Locked Features</td>
								</tr>
								<tr>
									<td>
										<strong>Installation & Setup</strong>
									</td>
									<td>Instant (Runs in Any Browser)</td>
									<td>Web App or Mobile App</td>
									<td>Multi-GB Download & Drivers</td>
								</tr>
								<tr>
									<td>
										<strong>Timeline & Interchange</strong>
									</td>
									<td>Multi-Track, OTIO, FCPXML, EDL</td>
									<td>Proprietary Cloud Project Files</td>
									<td>Proprietary / Pro Interchange</td>
								</tr>
								<tr>
									<td>
										<strong>AI Silence Trimming & Captions</strong>
									</td>
									<td>Smart Cut & Whisper (100% Free & Local)</td>
									<td>Paid Cloud Credits & Queue Delays</td>
									<td>Expensive Plugins or Cloud Add-ons</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>

				<!-- Section 7: FAQ -->
				<section class="seo-block" id="faq-section">
					<h2 class="seo-heading">Frequently Asked Questions</h2>
					<div class="faq-list">
						{faqItems.map((faq) => (
							<details class="faq-item">
								<summary class="faq-question">
									<span>{faq.question}</span>
									<svg
										class="faq-icon"
										width="16"
										height="16"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<polyline points="6 9 12 15 18 9"></polyline>
									</svg>
								</summary>
								<p class="faq-answer">{faq.answer}</p>
							</details>
						))}
					</div>
				</section>
			</div>
		</article>

		<!-- Buy Me A Coffee Support & Community Section -->
		<section class="home-support-section" id="community">
			<div class="support-container">
				<div class="community-card-container">
					<div class="community-card-inner">
						<div class="community-card-icon" aria-hidden="true">
							<svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
								<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"></path>
							</svg>
						</div>
						<div class="community-card-content">
							<h3 class="community-card-title">Join The Free Video Editor Discord</h3>
							<p class="community-card-desc">
								Chat with creators, share your video edits, get troubleshooting help, and build the future of browser video editing with us.
							</p>
						</div>
						<a
							href="https://discord.gg/6MtmjsA53V"
							target="_blank"
							rel="noopener noreferrer"
							class="community-discord-btn"
						>
							<span>Join Community</span>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					</div>
				</div>
				<BuyMeACoffee variant="card" />
			</div>
		</section>

		<!-- Multi-page Site Footer -->
		<Footer currentPage="/" />
	</div>
</Layout>

<style>
	.home-wrapper {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100dvh;
		background: #070709;
		color: var(--color-ink);
		overflow-x: hidden;
	}

	.home-hero {
		position: relative;
		display: grid;
		grid-template-rows: 1fr auto;
		min-height: 100vh;
		min-height: 100dvh;
		place-items: center;
		padding: 5.5rem var(--spacing-lg) 1.5rem;
		overflow: hidden;
		perspective: 1000px;
		box-sizing: border-box;
	}

	@media (max-width: 768px) {
		.home-hero {
			padding: 4.75rem var(--spacing-md) 1.5rem;
		}
	}

	/* Ambient space lighting */
	.ambient-glow {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
		filter: blur(90px);
		z-index: 1;
	}

	.ambient-glow-1 {
		top: 25%;
		left: 50%;
		width: min(80vw, 680px);
		height: min(50vh, 460px);
		transform: translate(-50%, -50%);
		background: radial-gradient(
			circle,
			rgba(0, 112, 243, 0.16) 0%,
			rgba(121, 40, 202, 0.1) 45%,
			transparent 75%
		);
		animation: pulse-glow 9s ease-in-out infinite alternate;
	}

	.ambient-glow-2 {
		bottom: 10%;
		left: 50%;
		width: min(70vw, 560px);
		height: min(40vh, 360px);
		transform: translateX(-50%);
		background: radial-gradient(
			circle,
			rgba(56, 189, 248, 0.1) 0%,
