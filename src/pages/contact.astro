---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const seoTitle = 'Contact Us — The Free Video Editor';
const seoDescription =
	'Get in touch with The Free Video Editor team. Reach out for support, technical questions, bug reports, feature requests, or partnership inquiries.';
---

<Layout
	title={seoTitle}
	description={seoDescription}
	canonicalUrl="https://thefreevideoeditor.com/contact/"
>
	<Header />

	<main class="page-main">
		<div class="page-container">
			<div class="page-header">
				<div class="eyebrow-badge">
					<span class="pulsing-dot" aria-hidden="true"></span>
					<span>WE ARE HERE TO HELP</span>
				</div>
				<h1 class="page-title">Contact Us</h1>
				<p class="page-lead">
					Have questions, feedback, or a feature request? We’d love to hear from you.
				</p>
			</div>

			<div class="channels-grid">
				<div class="contact-card info-card">
					<div class="info-icon">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
							<polyline points="22,6 12,13 2,6"></polyline>
						</svg>
					</div>
					<h3>Direct Email</h3>
					<p>For support, questions, legal, or partnerships:</p>
					<a href="mailto:contact@beestack.in" class="channel-link">contact@beestack.in</a>
				</div>

				<div class="contact-card info-card">
					<div class="info-icon">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
						</svg>
					</div>
					<h3>Open Source & Community</h3>
					<p>Report issues, contribute code, or view architecture discussions:</p>
					<a href="https://github.com/GajananPalepwad/TheFreeVideoEditor" target="_blank" rel="noopener noreferrer" class="channel-link">
						GitHub Repository &rarr;
					</a>
				</div>

				<div class="contact-card info-card discord-card">
					<div class="info-icon discord-icon">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
							<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"></path>
						</svg>
					</div>
					<h3>Discord Community</h3>
					<p>Join creators and developers, ask editing questions, and discuss features in real time:</p>
					<a href="https://discord.gg/6MtmjsA53V" target="_blank" rel="noopener noreferrer" class="channel-link discord-link">
						Join Discord Server &rarr;
					</a>
				</div>

				<div class="contact-card info-card faq-shortcut">
					<div class="info-icon">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
							<line x1="12" y1="17" x2="12.01" y2="17"></line>
						</svg>
					</div>
					<h3>Looking for Answers?</h3>
					<p>Check out our frequently asked questions on our home page for instant help on formats, shortcuts, and performance.</p>
					<a href="/#faq-section" class="channel-link">Visit FAQ &rarr;</a>
				</div>

				<div class="contact-card info-card bmc-card">
					<div class="info-icon bmc-icon" aria-hidden="true">
						☕
					</div>
					<h3>Support Our Work</h3>
					<p>Love using The Free Video Editor? Support future development, hosting, and AI models:</p>
					<a href="https://buymeacoffee.com/beestack" target="_blank" rel="noopener noreferrer" class="channel-link bmc-link">
						Buy Me a Coffee &rarr;
					</a>
				</div>
			</div>
		</div>
	</main>

	<Footer currentPage="/contact/" />
</Layout>

<style>
	.page-main {
		min-height: 100vh;
		background: #070709;
		color: #e2e8f0;
		padding: 7rem 1.5rem 5rem;
	}

	.page-container {
		max-width: 64rem;
		margin: 0 auto;
	}

	.page-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.eyebrow-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 5px 14px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #94a3b8;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		margin-bottom: 1.25rem;
	}

	.pulsing-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #38bdf8;
		box-shadow: 0 0 8px #38bdf8;
	}

	.page-title {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		color: #ffffff;
		margin: 0 0 1rem 0;
		line-height: 1.15;
	}

	.page-lead {
		font-size: 1.15rem;
		color: #94a3b8;
		line-height: 1.6;
		margin: 0 auto;
		max-width: 36rem;
	}

	.channels-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		align-items: stretch;
	}

	.contact-card {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 14px;
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.contact-card:hover {
		transform: translateY(-2px);
		border-color: rgba(56, 189, 248, 0.3);
	}

	.info-icon {
		display: inline-flex;
		align-self: flex-start;
		padding: 10px;
		border-radius: 10px;
		background: rgba(56, 189, 248, 0.1);
		color: #38bdf8;
		margin-bottom: 1rem;
	}

	.contact-card h3 {
		font-size: 1.2rem;
		color: #ffffff;
		margin: 0 0 0.5rem 0;
		font-weight: 600;
	}

	.contact-card p {
		color: #94a3b8;
		font-size: 0.9rem;
		line-height: 1.6;
		margin: 0 0 1.25rem 0;
		flex-grow: 1;
	}

	.channel-link {
		color: #38bdf8;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		transition: color 0.15s ease;
	}

	.channel-link:hover {
		color: #7dd3fc;
		text-decoration: underline;
	}

	.discord-card {
		border-color: rgba(88, 101, 242, 0.28);
		background: linear-gradient(135deg, rgba(88, 101, 242, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
	}

	.discord-card:hover {
		border-color: rgba(88, 101, 242, 0.55);
	}

	.discord-icon {
		background: rgba(88, 101, 242, 0.15);
		color: #5865f2;
	}

	.discord-link {
		color: #5865f2;
		font-weight: 600;
	}

	.discord-link:hover {
		color: #7983f5;
	}

	.bmc-card {
		border-color: rgba(255, 221, 0, 0.25);
		background: linear-gradient(135deg, rgba(255, 221, 0, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
	}

	.bmc-card:hover {
		border-color: rgba(255, 221, 0, 0.5);
	}

	.bmc-icon {
		background: rgba(255, 221, 0, 0.15);
		font-size: 1.25rem;
		line-height: 1;
	}

	.bmc-link {
		color: #ffdd00;
		font-weight: 600;
	}

	.bmc-link:hover {
		color: #ffe642;
	}

	@media (max-width: 640px) {
		.channels-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

