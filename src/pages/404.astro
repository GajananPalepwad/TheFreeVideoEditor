---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const seoTitle = '404: Page Not Found — The Free Video Editor';
const seoDescription =
	'Sorry, the page you are looking for does not exist on The Free Video Editor. Return home or jump straight into the timeline video editor.';
---

<Layout
	title={seoTitle}
	description={seoDescription}
	canonicalUrl="https://thefreevideoeditor.com/404/"
	robots="noindex, follow"
>
	<Header />

	<main class="error-main">
		<!-- Background ambient spatial glow -->
		<div class="ambient-glow ambient-glow-1" aria-hidden="true"></div>
		<div class="ambient-glow ambient-glow-2" aria-hidden="true"></div>

		<div class="error-container">
			<div class="error-badge">
				<span class="error-code">404 ERROR</span>
				<span class="sep">&bull;</span>
				<span>MISSING TIMELINE ASSET</span>
			</div>

			<h1 class="error-title">Cut Out of the Timeline</h1>

			<p class="error-description">
				The scene or URL you were looking for doesn't exist, has been moved, or was trimmed from the final project cut.
			</p>

			<div class="error-actions">
				<a href="/editor/" class="btn-primary">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polygon points="5 3 19 12 5 21 5 3"></polygon>
					</svg>
					<span>Open Video Editor</span>
				</a>

				<a href="/" class="btn-secondary">
					<span>Back to Home</span>
				</a>
			</div>

			<div class="quick-links">
				<p class="quick-links-title">Helpful Navigation Links:</p>
				<ul class="quick-links-list">
					<li><a href="/about/">About Us & Architecture</a></li>
					<li><a href="/contact/">Contact & Help</a></li>
					<li><a href="/privacy/">Privacy Policy</a></li>
					<li><a href="/terms/">Terms & Licensing</a></li>
				</ul>
			</div>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.error-main {
		position: relative;
		min-height: 85vh;
		display: grid;
		place-items: center;
		padding: 7rem 1.5rem 5rem;
		background: #070709;
		color: #e2e8f0;
		overflow: hidden;
	}

	.ambient-glow {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
		filter: blur(100px);
		z-index: 1;
	}

	.ambient-glow-1 {
		top: 25%;
		left: 45%;
		width: 450px;
		height: 380px;
		transform: translate(-50%, -50%);
		background: radial-gradient(circle, rgba(56, 189, 248, 0.12) 0%, rgba(168, 85, 247, 0.08) 50%, transparent 75%);
	}

	.ambient-glow-2 {
		bottom: 15%;
		left: 55%;
		width: 400px;
		height: 320px;
		background: radial-gradient(circle, rgba(239, 68, 68, 0.08) 0%, transparent 70%);
	}

	.error-container {
		position: relative;
		z-index: 10;
		max-width: 40rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.error-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 5px 14px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #94a3b8;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		margin-bottom: 1.5rem;
	}

	.error-code {
		color: #38bdf8;
		font-weight: 600;
	}

	.sep {
		color: #64748b;
	}

	.error-title {
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.1;
		color: #ffffff;
		margin: 0 0 1rem 0;
	}

	.error-description {
		font-size: 1.1rem;
		color: #94a3b8;
		line-height: 1.6;
		margin: 0 0 2.25rem 0;
		max-width: 32rem;
	}

	.error-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 3rem;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 0.75rem 1.75rem;
		border-radius: 9999px;
		background: #ededed;
		color: #090909;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: all 0.2s ease;
		box-shadow: 0 0 20px rgba(255, 255, 255, 0.15);
	}

	.btn-primary:hover {
		background: #ffffff;
		box-shadow: 0 0 30px rgba(56, 189, 248, 0.35);
		transform: translateY(-1px);
	}

	.btn-secondary {
		display: inline-flex;
		align-items: center;
		padding: 0.75rem 1.5rem;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: #ffffff;
		font-weight: 500;
		font-size: 0.95rem;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.12);
		border-color: rgba(255, 255, 255, 0.3);
	}

	.quick-links {
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding-top: 1.75rem;
		width: 100%;
	}

	.quick-links-title {
		color: #64748b;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-weight: 600;
		margin: 0 0 0.85rem 0;
	}

	.quick-links-list {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1.25rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.quick-links-list a {
		color: #94a3b8;
		text-decoration: none;
		font-size: 0.875rem;
		transition: color 0.15s ease;
	}

	.quick-links-list a:hover {
		color: #38bdf8;
		text-decoration: underline;
	}
</style>

