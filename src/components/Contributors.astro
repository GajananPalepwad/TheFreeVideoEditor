<section class="contributors" aria-labelledby="contributors-title" data-contributors>
	<h2 id="contributors-title">Built with the community</h2>
	<p class="contributors-subtitle">Meet the people contributing to this project.</p>

	<p class="contributors-status" role="status" data-status>
		Loading contributors...
	</p>

	<div class="contributors-viewport" data-viewport hidden>
		<div class="contributors-track" data-track></div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-contributors]').forEach((root) => {
		const status = root.querySelector<HTMLElement>('[data-status]');
		const viewport = root.querySelector<HTMLElement>('[data-viewport]');
		const track = root.querySelector<HTMLElement>('[data-track]');

		const repo = 'GajananPalepwad/TheFreeVideoEditor';
		let resizeObserver: ResizeObserver | undefined;

		async function loadContributors() {
			if (!status || !viewport || !track) return;

			try {
				const response = await fetch(
					`https://api.github.com/repos/${repo}/contributors?per_page=100`
				);

				if (!response.ok) {
					throw new Error(`GitHub API returned ${response.status}`);
				}

				const data: unknown = await response.json();

				if (!Array.isArray(data)) {
					throw new Error('Invalid contributors response');
				}

				const contributors = data.filter(
					(
						item
					): item is {
						login: string;
						avatar_url: string;
						html_url: string;
						type: string;
					} =>
						typeof item?.login === 'string' &&
						typeof item?.avatar_url === 'string' &&
						typeof item?.html_url === 'string' &&
						item.type !== 'Bot'
				);

				const unique = Array.from(
					new Map(contributors.map((person) => [person.login, person])).values()
				);

				if (unique.length === 0) {
					status.textContent = 'Contributors will appear here soon.';
					return;
				}

				const createGroup = (hidden = false) => {
					const group = document.createElement('div');
					group.className = 'contributors-group';

					if (hidden) group.setAttribute('aria-hidden', 'true');

					unique.forEach((person) => {
						const link = document.createElement('a');
						link.className = 'contributor';
						link.href = person.html_url;
						link.target = '_blank';
						link.rel = 'noopener noreferrer';
						link.title = person.login;

						if (hidden) link.tabIndex = -1;

						const avatar = document.createElement('img');
						avatar.src = person.avatar_url;
						avatar.alt = hidden ? '' : `${person.login}'s GitHub avatar`;
						avatar.width = 40;
						avatar.height = 40;
						avatar.loading = 'lazy';

						const username = document.createElement('span');
						username.textContent = person.login;

						link.append(avatar, username);
						group.append(link);
					});

					return group;
				};

				const firstGroup = createGroup();
				track.replaceChildren(firstGroup, createGroup(true));

				viewport.hidden = false;
				status.hidden = true;

				const updateLoop = () => {
					const groupWidth = firstGroup.getBoundingClientRect().width;

					if (groupWidth <= 0) return;

					track.style.setProperty('--scroll-distance', `-${groupWidth}px`);

					const groupCount = Math.ceil(viewport.clientWidth / groupWidth) + 1;

					while (track.children.length < groupCount) {
						track.append(createGroup(true));
					}

					while (track.children.length > groupCount) {
						track.lastElementChild?.remove();
					}
				};

				updateLoop();
				resizeObserver = new ResizeObserver(updateLoop);
				resizeObserver.observe(firstGroup);
				resizeObserver.observe(viewport);

				track.classList.add('is-ready');
			} catch {
				status.textContent = 'Contributors are temporarily unavailable. Please try again later.';
			}
		}

		loadContributors();
	});
</script>

<style is:global>
	.contributors {
		position: relative;
		z-index: 10;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		margin-top: 0.5rem;
		padding: 0;
		box-sizing: border-box;
		overflow: hidden;
		text-align: center;
		color: #f1f5f9;
	}

	.contributors h2 {
		margin: 0;
		font-size: clamp(1.1rem, 2vw, 1.4rem);
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.contributors-subtitle {
		margin: 0.35rem 0 1rem;
		color: #94a3b8;
		font-size: 0.875rem;
	}

	.contributors-status {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 56px;
		margin: 0;
		color: #94a3b8;
		font-size: 0.875rem;
	}

	.contributors-viewport {
		display: block;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		min-height: 56px;
		padding: 16px 0 32px;
		overflow: hidden;
		box-sizing: border-box;
		-webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
	}

	.contributors-track {
		display: flex;
		width: max-content;
		max-width: none;
		flex-wrap: nowrap;
		will-change: transform;
		animation: contributors-scroll 35s linear infinite;
		animation-play-state: paused;
	}

	.contributors-track.is-ready {
		animation-play-state: running;
	}

	.contributors-group {
		display: flex;
		flex: 0 0 auto;
		flex-wrap: nowrap;
		align-items: center;
		gap: 1rem;
		padding-right: 1rem;
	}

	.contributor {
		position: relative;
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.7rem;
		padding: 0.6rem 1rem;
		border: 1px solid rgba(148, 163, 184, 0.2);
		border-radius: 999px;
		background: rgba(15, 23, 42, 0.65);
		color: #e2e8f0;
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
		transition:
			transform 200ms ease,
			border-color 200ms ease,
			background-color 200ms ease,
			box-shadow 200ms ease,
			color 200ms ease;
	}

	.contributor img {
		display: block;
		width: 38px;
		height: 38px;
		flex: 0 0 38px;
		border: 2px solid rgba(56, 189, 248, 0.35);
		border-radius: 50%;
		object-fit: cover;
		transition: border-color 200ms ease;
	}

	.contributor:hover {
		z-index: 2;
		transform: translateY(-3px);
		border-color: rgba(56, 189, 248, 0.7);
		background: rgba(30, 41, 59, 0.95);
		box-shadow: 0 8px 24px rgba(56, 189, 248, 0.16);
		color: #7dd3fc;
	}

	.contributor:hover img {
		border-color: #38bdf8;
	}

	.contributor:focus-visible {
		outline: 2px solid #38bdf8;
		outline-offset: 4px;
	}

	.contributors-viewport:hover .contributors-track,
	.contributors-viewport:focus-within .contributors-track {
		animation-play-state: paused;
	}

	@keyframes contributors-scroll {
		from {
			transform: translateX(0);
		}

		to {
			transform: translateX(var(--scroll-distance, -50%));
		}
	}

	@media (max-width: 600px) {
		.contributors {
			margin-top: 1.5rem;
		}

		.contributors-group {
			gap: 0.75rem;
			padding-right: 0.75rem;
		}

		.contributor {
			gap: 0.5rem;
			padding: 0.5rem 0.75rem;
			font-size: 0.8rem;
		}

		.contributor img {
			width: 32px;
			height: 32px;
			flex-basis: 32px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contributors-viewport {
			overflow-x: auto;
			-webkit-mask-image: none;
			mask-image: none;
		}

		.contributors-track,
		.contributors-track.is-ready {
			width: 100%;
			animation: none;
			transform: none;
			will-change: auto;
		}

		.contributors-group[aria-hidden='true'] {
			display: none;
		}

		.contributor {
			transition: none;
		}
	}
</style>
