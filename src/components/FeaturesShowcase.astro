---

<section class="features-section" id="features">
	<!-- Ambient Background Glows -->
	<div class="features-ambient-glow" aria-hidden="true"></div>

	<div class="features-container">
		<!-- Section Header -->
		<div class="features-header">
			<div class="features-eyebrow">
				<span class="eyebrow-dot"></span>
				<span>COMPLETE PROFESSIONAL FEATURE SUITE</span>
			</div>
			<h2 class="features-title">
				Every Feature You Need to Create <span class="gradient-text">World-Class Edits</span>
			</h2>
			<p class="features-subtitle">
				A complete non-linear editing studio engineered with WebCodecs and WebGL2. No downloads, no
				subscriptions, and zero cloud uploads — your footage stays completely on your device.
			</p>

			<!-- At a glance stats strip -->
			<div class="features-stats-strip">
				<div class="stat-item">
					<span class="stat-number">28+</span>
					<span class="stat-label">Pro Features</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-item">
					<span class="stat-number">4K 60fps</span>
					<span class="stat-label">GPU Acceleration</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-item">
					<span class="stat-number">0 Bytes</span>
					<span class="stat-label">Cloud Upload</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-item">
					<span class="stat-number">100% Free</span>
					<span class="stat-label">No Watermarks</span>
				</div>
			</div>
		</div>

		<!-- Interactive Category Filter Tabs -->
		<div class="features-filter-bar" role="tablist" aria-label="Feature categories">
			{categories.map((cat, idx) => (
				<button
					type="button"
					class={`filter-tab ${idx === 0 ? 'is-active' : ''}`}
					data-category={cat.id}
					role="tab"
					aria-selected={idx === 0 ? 'true' : 'false'}
				>
					{cat.label}
				</button>
			))}
		</div>

		<!-- Features Grid -->
		<div class="features-grid" id="features-grid">
			{features.map((feature) => (
				<div class="feature-card" data-category={feature.category}>
					<div class="card-top">
						<div class="feature-icon-wrapper" aria-hidden="true">
							{feature.icon === 'timeline' && (
								<svg
									width="22"
									height="22"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<rect x="2" y="4" width="20" height="4" rx="1" />
									<rect x="2" y="10" width="12" height="4" rx="1" />
									<rect x="2" y="16" width="16" height="4" rx="1" />
									<line
										x1="10"
										y1="2"
										x2="10"
										y2="22"
										stroke-dasharray="2 2"
										stroke="currentColor"
									/>
								</svg>
							)}
							{feature.icon === 'scissors' && (
								<svg
									width="22"
									height="22"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="6" cy="6" r="3" />
									<circle cx="6" cy="18" r="3" />
									<line x1="20" y1="4" x2="8.12" y2="15.88" />
									<line x1="14.47" y1="14.48" x2="20" y2="20" />
									<line x1="8.12" y1="8.12" x2="12" y2="12" />
								</svg>
							)}
							{feature.icon === 'split-cuts' && (
								<svg
									width="22"
									height="22"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M4 6h16M4 12h10M18 12h2M4 18h16" />
									<polyline points="14 9 17 12 14 15" />
								</svg>
							)}
							{feature.icon === 'keyframes' && (
								<svg
									width="22"
									height="22"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M12 2L2 12l10 10 10-10L12 2z" />
									<path d="M12 7l-5 5 5 5 5-5-5-5z" />
								</svg>
							)}
							{feature.icon === 'gizmo' && (
								<svg
									width="22"
									height="22"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M21 3H3v18h18V3z" stroke-dasharray="3 3" />
									<rect x="2" y="2" width="3" height="3" fill="currentColor" />
									<rect x="19" y="2" width="3" height="3" fill="currentColor" />
									<rect x="2" y="19" width="3" height="3" fill="currentColor" />
									<rect x="19" y="19" width="3" height="3" fill="currentColor" />
									<circle cx="12" cy="12" r="2" />
								</svg>
							)}
							{feature.icon === 'speed' && (
								<svg
									width="22"
									height="22"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="12" cy="12" r="10" />
									<polyline points="12 6 12 12 16 14" />
									<path d="M16 2l4 4" />
								</svg>
							)}
							{feature.icon === 'captions' && (
								<svg
									width="22"
									height="22"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<rect x="2" y="4" width="20" height="16" rx="3" />
									<path d="M7 15h4M7 9h2M15 15h2M13 9h4" />
								</svg>
							)}
							{feature.icon === 'silence' && (
								<svg
									width="22"
